<Window x:Class="DeepSeekHarnessDesktop.LogViewer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="日志查看器 - DeepSeek Harness Desktop"
        Width="800" Height="500"
        WindowStartupLocation="CenterScreen"
        FontFamily="Consolas" FontSize="12">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
            <Button x:Name="BtnRefresh" Content="刷新" Width="70" Height="26" Click="OnRefresh" />
            <Button x:Name="BtnAutoScroll" Content="自动滚动" Width="80" Height="26" Margin="8,0,0,0" Click="OnToggleAutoScroll" />
            <TextBlock x:Name="TxtInfo" VerticalAlignment="Center" Margin="12,0,0,0" Text="就绪" Foreground="Gray" />
        </StackPanel>
        <TextBox x:Name="LogContent" Grid.Row="1"
                 IsReadOnly="True"
                 VerticalScrollBarVisibility="Visible"
                 HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap"
                 Background="#1E1E1E" Foreground="#D4D4D4"
                 BorderThickness="1" BorderBrush="#444" />
        <StatusBar Grid.Row="2" Margin="0,4,0,0">
            <StatusBarItem x:Name="StatusInfo" Content="正在监控日志…" />
        </StatusBar>
    </Grid>
</Window>