<Window x:Class="DeepSeekHarnessDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="DeepSeek Harness Desktop"
        Width="1200" Height="800"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A2E">
    <Grid>
        <wv2:WebView2 x:Name="Browser"
                      Source="about:blank"
                      NavigationStarting="OnNavigationStarting"
                      NavigationCompleted="OnNavigationCompleted"
                      CoreWebView2InitializationCompleted="OnCoreWebView2Init" />
        <Border x:Name="LoadingOverlay"
                Background="#1A1A2E"
                Visibility="Visible"
                Panel.ZIndex="100">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="LoadingStatusText"
                           Text="正在启动 DSH 服务…"
                           Foreground="#E0E0E0"
                           FontSize="18"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <ProgressBar x:Name="LoadingProgress"
                             IsIndeterminate="True"
                             Width="200" Height="4"
                             Margin="0,16,0,0"
                             Foreground="#4A90D9"
                             Background="#333" />
                <TextBlock x:Name="LoadingErrorText"
                           Text=""
                           Foreground="#FF6B6B"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0"
                           Visibility="Collapsed"
                           TextWrapping="Wrap"
                           MaxWidth="400" />
            </StackPanel>
        </Border>
    </Grid>
</Window>