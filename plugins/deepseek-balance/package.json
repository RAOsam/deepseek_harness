{
  "name": "deepseek-balance",
  "version": "0.1.0",
  "description": "DeepSeek 余额监控与用量统计插件：侧边栏页脚余额组件 + 官方余额 API 代理（密钥不出服务端）+ 一键充值跳转官方充值页",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.6"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "license": "MIT"
}
